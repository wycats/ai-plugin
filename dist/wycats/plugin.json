{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wycats",
  "version": "0.1.0",
  "description": "Personal agent toolkit: workflow agents, skills, instructions, and hooks.",
  "extensions": {
    "com.github.copilot": {
      "agents": {
        "paths": [
          "./agents/editorial-reader.agent.md",
          "./agents/recon-worker.agent.md",
          "./agents/recon.agent.md"
        ],
        "exclusive": true
      },
      "rules": {
        "paths": [
          "./rules/environment.instructions.md"
        ],
        "exclusive": true
      }
    }
  }
}
